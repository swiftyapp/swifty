{
  "name": "swifty",
  "version": "1.0.0-alpha.1",
  "description": "Modern, Lightweight, Fast and Free Password Manager",
  "type": "module",
  "repository": "https://github.com/swiftyapp/swifty.git",
  "author": {
    "name": "Alex Chaplinsky",
    "email": "alchaplinsky@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wdio run tests/e2e/wdio.conf.ts",
    "test:e2e:build": "bun run build && cargo build --manifest-path src-tauri/Cargo.toml && bun run test:e2e",
    "logo": "bun run scripts/logo.tsx",
    "icons": "tauri icon src-tauri/icons/asterisq.svg -o src-tauri/icons && tauri icon src-tauri/icons/tray.svg -o src-tauri/icons/tray -p 72",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "fuse.js": "^7.5.0",
    "i18next": "^26.4.1",
    "i18next-resources-to-backend": "^1.2.3",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@wdio/cli": "^8.46.0",
    "@wdio/globals": "^8.46.0",
    "@wdio/local-runner": "^8.46.0",
    "@wdio/mocha-framework": "^8.46.0",
    "@wdio/spec-reporter": "^8.43.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.5",
    "fit-curve": "^0.2.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vite-plugin-svgr": "4.5.0",
    "vitest": "^4.1.11",
    "webdriverio": "^8.46.0"
  }
}
