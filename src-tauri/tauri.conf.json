{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swifty",
  "version": "1.0.0",
  "identifier": "pro.getswifty.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Swifty",
        "create": false,
        "width": 900,
        "height": 700,
        "center": true,
        "resizable": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "fileAssociations": [
      {
        "ext": ["swftx"],
        "name": "Swifty Vault",
        "description": "Swifty encrypted vault",
        "mimeType": "application/vnd.swftx"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/swiftyapp/swifty/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGQTdDRTcxNDlGMkZCRjMKUldUeisvSkpjYzZuYjVQV0Y5bWpvRE9jM0ZOYkJEOXF1cTJlcXBUQzVZblYvNThEVUhPbG9LTWYK"
    }
  }
}
