{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swifty",
  "version": "1.0.0",
  "identifier": "pro.getswifty.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Swifty",
        "create": false,
        "width": 460,
        "height": 500,
        "resizable": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["swftx"],
        "name": "Swifty Vault",
        "description": "Swifty encrypted vault",
        "mimeType": "application/vnd.swftx"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/swiftyapp/swifty/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
